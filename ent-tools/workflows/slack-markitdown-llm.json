{
  "name": "Slack file → MarkItDown → LLM → reply",
  "nodes": [
    {
      "id": "webhook_trigger",
      "name": "Webhook (Slack events)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "parameters": {
        "path": "slack-markitdown",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "slack-markitdown-llm"
    },
    {
      "id": "manual_trigger",
      "name": "Manual Trigger (test)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 220],
      "parameters": {}
    },
    {
      "id": "normalize_inbound",
      "name": "Normalize inbound (Slack → internal)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [240, 110],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            { "id": "source", "name": "source", "value": "slack", "type": "string" },
            { "id": "channel_id", "name": "channel_id", "value": "={{ $json.event?.channel_id ?? $json.channel_id ?? '' }}", "type": "string" },
            { "id": "thread_ts", "name": "thread_ts", "value": "={{ $json.event?.ts ?? $json.thread_ts ?? '' }}", "type": "string" },
            { "id": "file_id", "name": "file_id", "value": "={{ $json.event?.file_id ?? $json.file_id ?? '' }}", "type": "string" },
            { "id": "filename", "name": "filename", "value": "={{ $json.event?.file?.name ?? $json.filename ?? 'document' }}", "type": "string" },
            { "id": "ok", "name": "ok", "value": true, "type": "boolean" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "slack_get_file",
      "name": "Slack get file info",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [460, 110],
      "parameters": {
        "operation": "get",
        "resource": "file",
        "fileId": "={{ $json.file_id }}"
      },
      "credentials": { "slackOAuth2Api": { "id": "", "name": "Slack account" } }
    },
    {
      "id": "download_slack_file",
      "name": "Download file from Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [560, 110],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url_private_download }}",
        "options": {
          "response": { "response": { "responseFormat": "file", "outputPropertyName": "data" } },
          "timeout": 30000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": { "httpHeaderAuth": { "id": "", "name": "Slack Bot Token (Bearer)" } }
    },
    {
      "id": "call_markitdown",
      "name": "Call MarkItDown API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [780, 110],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MARKITDOWN_API_URL || ($vars.tools && $vars.tools.markitdown && $vars.tools.markitdown.url) || 'https://markitdown-api.railway.app' }}/convert",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            { "parameterType": "formBinaryData", "name": "file", "inputDataFieldName": "data", "mimeType": "" }
          ]
        },
        "options": { "timeout": 60000 }
      }
    },
    {
      "id": "normalize_markitdown_response",
      "name": "Normalize MarkItDown response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1000, 110],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            { "id": "source", "name": "source", "value": "={{ $('Normalize inbound (Slack → internal)').item.json.source }}", "type": "string" },
            { "id": "channel_id", "name": "channel_id", "value": "={{ $('Normalize inbound (Slack → internal)').item.json.channel_id }}", "type": "string" },
            { "id": "thread_ts", "name": "thread_ts", "value": "={{ $('Normalize inbound (Slack → internal)').item.json.thread_ts }}", "type": "string" },
            { "id": "filename", "name": "filename", "value": "={{ $('Normalize inbound (Slack → internal)').item.json.filename }}", "type": "string" },
            { "id": "ok", "name": "ok", "value": "={{ $json.body?.ok ?? $json.ok ?? !!($json.body?.markdown ?? $json.markdown) }}", "type": "boolean" },
            { "id": "markdown", "name": "markdown", "value": "={{ $json.body?.markdown ?? $json.markdown ?? '' }}", "type": "string" },
            { "id": "error", "name": "error", "value": "={{ $json.body?.error ?? $json.error ?? '' }}", "type": "string" },
            { "id": "stage", "name": "stage", "value": "={{ $json.body?.stage ?? $json.stage ?? 'markitdown' }}", "type": "string" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "if_convert_ok",
      "name": "Conversion OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1220, 110],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [{ "id": "ok", "leftValue": "={{ $json.ok }}", "rightValue": true, "operator": { "type": "boolean", "operation": "equals" } }],
          "combinator": "and"
        }
      }
    },
    {
      "id": "openai_chat",
      "name": "OpenAI Chat",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.3,
      "position": [1340, 0],
      "parameters": {
        "resource": "chat",
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Use the document (markdown) provided to answer or summarize. Be concise."
            },
            {
              "role": "user",
              "content": "=## Document\n\n{{ $json.markdown }}"
            }
          ]
        },
        "options": { "maxTokens": 1024 }
      },
      "credentials": { "openAiApi": { "id": "", "name": "OpenAI account" } }
    },
    {
      "id": "normalize_llm_response",
      "name": "Normalize LLM output",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1560, 0],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            { "id": "channel_id", "name": "channel_id", "value": "={{ $('Normalize MarkItDown response').item.json.channel_id }}", "type": "string" },
            { "id": "thread_ts", "name": "thread_ts", "value": "={{ $('Normalize MarkItDown response').item.json.thread_ts }}", "type": "string" },
            { "id": "llm_response", "name": "llm_response", "value": "={{ $json.message?.content ?? $json.choices?.[0]?.message?.content ?? $json.text ?? JSON.stringify($json) }}", "type": "string" },
            { "id": "ok", "name": "ok", "value": true, "type": "boolean" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "slack_reply",
      "name": "Slack reply (success)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [1780, 0],
      "parameters": {
        "select": "channel",
        "channelId": { "__rl": true, "value": "={{ $json.channel_id }}", "mode": "id" },
        "text": "={{ $json.llm_response }}",
        "otherOptions": { "thread_ts": "={{ $json.thread_ts || undefined }}" }
      },
      "credentials": { "slackOAuth2Api": { "id": "", "name": "Slack account" } }
    },
    {
      "id": "slack_reply_error",
      "name": "Slack reply (error)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [1340, 220],
      "parameters": {
        "select": "channel",
        "channelId": { "__rl": true, "value": "={{ $json.channel_id }}", "mode": "id" },
        "text": "=Sorry, conversion failed: {{ $json.error || 'Unknown error' }}",
        "otherOptions": { "thread_ts": "={{ $json.thread_ts || undefined }}" }
      },
      "credentials": { "slackOAuth2Api": { "id": "", "name": "Slack account" } }
    }
  ],
  "connections": {
    "Webhook (Slack events)": { "main": [[{ "node": "Normalize inbound (Slack → internal)", "type": "main", "index": 0 }]] },
    "Manual Trigger (test)": { "main": [[{ "node": "Normalize inbound (Slack → internal)", "type": "main", "index": 0 }]] },
    "Normalize inbound (Slack → internal)": { "main": [[{ "node": "Slack get file info", "type": "main", "index": 0 }]] },
    "Slack get file info": { "main": [[{ "node": "Download file from Slack", "type": "main", "index": 0 }]] },
    "Download file from Slack": { "main": [[{ "node": "Call MarkItDown API", "type": "main", "index": 0 }]] },
    "Call MarkItDown API": { "main": [[{ "node": "Normalize MarkItDown response", "type": "main", "index": 0 }]] },
    "Normalize MarkItDown response": { "main": [[{ "node": "Conversion OK?", "type": "main", "index": 0 }]] },
    "Conversion OK?": {
      "main": [
        [{ "node": "OpenAI Chat", "type": "main", "index": 0 }],
        [{ "node": "Slack reply (error)", "type": "main", "index": 0 }]
      ]
    },
    "OpenAI Chat": { "main": [[{ "node": "Normalize LLM output", "type": "main", "index": 0 }]] },
    "Normalize LLM output": { "main": [[{ "node": "Slack reply (success)", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
