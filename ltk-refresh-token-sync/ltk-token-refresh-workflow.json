      "parameters": {
        "jsCode": "// Extract records array from Airtable response\nconst response = $input.first().json;\nconst records = response.records || [];\n\nif (records.length === 0) {\n  return [{ json: { _empty: true, message: 'No active creators found' } }];\n}\n\nreturn records.map(rec => ({ json: rec }));"
