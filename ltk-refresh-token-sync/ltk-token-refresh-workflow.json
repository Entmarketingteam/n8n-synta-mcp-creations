    {
      "parameters": {
        "jsCode": "// Check if refresh was successful\nconst httpResponse = $input.first().json;\nconst statusCode = httpResponse.statusCode || httpResponse.status || 0;\nconst body = httpResponse.body || httpResponse;\n\n// Get the original creator record from the batch\nconst creatorRecord = $('One At A Time').first().json;\n\nif (statusCode === 200 || body.access_token) {\n  // SUCCESS - parse tokens and JWT exp\n  const responseBody = body.access_token ? body : (body.body || body);\n  \n  // Decode JWT to get expiration\n  let expiresAt = null;\n  try {\n    const jwtPayload = JSON.parse(\n      Buffer.from(responseBody.access_token.split('.')[1], 'base64').toString()\n    );\n    expiresAt = new Date(jwtPayload.exp * 1000).toISOString();\n  } catch (e) {\n    // If JWT parsing fails, set expiry to 10 hours from now (LTK default)\n    expiresAt = new Date(Date.now() + 10 * 60 * 60 * 1000).toISOString();\n  }\n\n  return [{\n    json: {\n      success: true,\n      recordId: creatorRecord.id,\n      creatorName: creatorRecord.fields.Creator,\n      updatePayload: {\n        records: [{\n          id: creatorRecord.id,\n          fields: {\n            Access_Token: responseBody.access_token,\n            ID_Token: responseBody.id_token || '',\n            Refresh_Token: responseBody.refresh_token || creatorRecord.fields.Refresh_Token,\n            Last_Refreshed: new Date().toISOString(),\n            Token_Expires_At: expiresAt,\n            Status: 'active',\n            Error_Message: '',\n            Consecutive_Failures: 0,\n            Alert_Sent: false\n          }\n        }]\n      }\n    }\n  }];\n} else {\n  // FAILURE - build error update\n  const prevFailures = creatorRecord.fields.Consecutive_Failures || 0;\n  const newFailures = prevFailures + 1;\n  const alertAlreadySent = creatorRecord.fields.Alert_Sent || false;\n  \n  let errorMsg = '';\n  try {\n    errorMsg = typeof body === 'string' ? body : JSON.stringify(body);\n  } catch (e) {\n    errorMsg = 'Unknown error - could not parse response';\n  }\n  if (errorMsg.length > 1000) errorMsg = errorMsg.substring(0, 1000);\n\n  return [{\n    json: {\n      success: false,\n      recordId: creatorRecord.id,\n      creatorName: creatorRecord.fields.Creator,\n      creatorEmail: creatorRecord.fields.Email || '',\n      shouldAlert: newFailures >= 3 && !alertAlreadySent,\n      consecutiveFailures: newFailures,\n      errorMessage: errorMsg,\n      updatePayload: {\n        records: [{\n          id: creatorRecord.id,\n          fields: {\n            Error_Message: errorMsg,\n            Consecutive_Failures: newFailures,\n            Status: newFailures >= 3 ? 'error' : creatorRecord.fields.Status\n          }\n        }]\n      }\n    }\n  }];\n}"
      },
