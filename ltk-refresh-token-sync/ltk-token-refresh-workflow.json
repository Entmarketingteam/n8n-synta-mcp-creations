      "id": "refresh-token",
      "name": "Refresh LTK Token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, -100],
      "onError": "continueRegularOutput",
      "retryOnFail": false
