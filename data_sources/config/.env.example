# SEO Machine - Data Sources Configuration
# Copy to .env and fill in values, or use Doppler (see setup-doppler.sh)
# Never commit the .env file with real values.

# --- Keywords Everywhere ---
# Get your API key from: https://keywordseverywhere.com/ke-api-dashboard.html
KEYWORDS_EVERYWHERE_API_KEY=

# --- DataForSEO ---
# https://app.dataforseo.com/
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Google Search Console ---
# Service account with GSC access
GSC_SITE_URL=https://yoursite.com
GSC_CREDENTIALS_FILE=config/gsc-service-account.json

# --- Google Analytics 4 ---
GA4_PROPERTY_ID=
GA4_CREDENTIALS_FILE=config/ga4-service-account.json

# --- WordPress Publishing ---
WORDPRESS_URL=https://yourblog.com
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
