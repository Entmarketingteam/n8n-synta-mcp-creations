# Copy to .env and fill in values. Never commit .env.

# --- Creator credentials (store here or in n8n Credentials; never commit real values) ---
# Amazon Associates (scraper): amazon-associates-scraper/.env
# AMAZON_ASSOC_EMAIL=your-creator@example.com
# AMAZON_ASSOC_PASSWORD=your-secure-password
# AMAZON_TRACKING_IDS=nicki-20

# ShopMy (runner / workflows): or use n8n Credentials
# SHOPMY_EMAIL=your-creator@example.com
# SHOPMY_PASSWORD=your-secure-password

# LTK (LikeToKnow.it) – optional; used for manual re-login if refresh token expires (see docs/LTK-NICKI-OAUTH2-SETUP.md, ltk-refresh-token-sync). Prefer storing refresh token in Airtable; email/password only when re-extracting token.
# LTK_NICKI_EMAIL=your-ltk-creator@example.com
# LTK_NICKI_PASSWORD=your-ltk-password

# Amazon Creators API (token): or use Airtable tblNovDWyu1iHoJf0
# AMAZON_CREATORS_API_CLIENT_ID=your-credential-id
# AMAZON_CREATORS_API_CLIENT_SECRET=your-credential-secret

# --- n8n API (for script: scripts/import-workflows-to-n8n.js) ---
# N8N_API_KEY=your-n8n-api-key
# N8N_BASE_URL=https://entagency.app.n8n.cloud

# --- Browserbase (shopmy-browserbase-runner) ---
# BROWSERBASE_API_KEY=bb_live_xxxx
# BROWSERBASE_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# PORT=3333

# --- Optional: used by workflows if set in n8n instance env ---
# APIFY_TOKEN=
# APIFY_TIKTOK_ACTOR_ID=
# BLOTATO_API_KEY=
# ELEVENLABS_API_KEY=
# PIAPI_API_KEY=
# CREATOMATE_API_KEY=
# OPENAI_API_KEY=

# --- last30days-skill (ent-tools/last30days-skill): Reddit + X research ---
# Config file: ~/.config/last30days/.env (or set here)
# OPENAI_API_KEY=sk-...                   # OpenAI Responses API (Reddit search)
# XAI_API_KEY=xai-...                     # xAI API (X/Twitter search)
# OPENAI_MODEL_POLICY=auto                # 'auto' or 'pinned'
# OPENAI_MODEL_PIN=gpt-4o                 # Pin to a specific OpenAI model
# XAI_MODEL_POLICY=latest                 # 'latest', 'stable', or 'pinned'
# XAI_MODEL_PIN=grok-4-1-fast             # Pin to a specific xAI model

# --- Other project env (examples only) ---
# FIRECRAWL_API_KEY=
# ANTHROPIC_API_KEY=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# PINECONE_API_KEY=
# MEILISEARCH_HOST=
# MEILISEARCH_API_KEY=
# DEEPGRAM_API_KEY=
