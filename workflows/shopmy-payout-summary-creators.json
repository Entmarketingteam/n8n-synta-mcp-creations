      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [2200, 500],
      "notes": "Same Earnings sheet as Amazon ingest and ShopMy CSV processor. Set Document ID or CREATOR_EARNINGS_SHEET_ID / SHOPMY_GSHEET_URL in n8n.",
      "onError": "continueRegularOutput"
