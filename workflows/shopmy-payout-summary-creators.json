    {
      "parameters": {
        "jsCode": "// Combine all data from payout_summary endpoint\nconst sessionData = $('Extract Session').item.json;\nconst payoutSummary = $('Get Payout Summary').item.json.body?.data || {};\nconst paymentsData = $('Get Payment History').item.json.body?.payments || [];\nconst brandRates = $('Get Brand Rates').item.json.body?.rates || [];\n\n// Extract structured data from payout_summary (this is the goldmine!)\nconst normalCommissions = payoutSummary.normal_commissions || [];\nconst opportunityCommissions = payoutSummary.opportunity_commissions || [];\nconst shopperReferralBonuses = payoutSummary.shopper_referral_bonuses || [];\nconst allPayouts = payoutSummary.payouts || [];\n\n// Calculate totals\nconst totalNormalCommissions = normalCommissions.reduce((sum, c) => sum + (parseFloat(c.amountEarned) || 0), 0);\nconst totalOpportunityCommissions = opportunityCommissions.reduce((sum, c) => sum + (parseFloat(c.amountEarned) || 0), 0);\nconst totalReferralBonuses = shopperReferralBonuses.reduce((sum, c) => sum + (parseFloat(c.amountEarned) || 0), 0);\n\n// Get pending vs paid breakdown\nconst pendingCommissions = allPayouts.filter(p => p.status === 'pending' || !p.isPaid);\nconst paidCommissions = allPayouts.filter(p => p.isPaid);\n\nreturn [{\n  json: {\n    // Creator info\n    creator_name: sessionData.creator_name,\n    user_id: sessionData.user_id,\n    extracted_at: new Date().toISOString(),\n    \n    // Summary totals\n    summary: {\n      today_amount: payoutSummary.todayAmount || 0,\n      total_normal_commissions: totalNormalCommissions,\n      total_opportunity_commissions: totalOpportunityCommissions,\n      total_referral_bonuses: totalReferralBonuses,\n      total_all: totalNormalCommissions + totalOpportunityCommissions + totalReferralBonuses\n    },\n    \n    // Monthly breakdown\n    months: payoutSummary.months || [],\n    \n    // Commission details (recent 50 for each type)\n    normal_commissions: normalCommissions.slice(0, 50).map(c => ({\n      date: c.transaction_date,\n      merchant: c.merchant,\n      product: c.Product_title,\n      order_amount: c.order_amount,\n      commission: c.commission_amount,\n      earned: c.amountEarned,\n      status: c.statusDisplay,\n      is_paid: c.isPaid,\n      is_locked: c.isLocked\n    })),\n    \n    opportunity_commissions: opportunityCommissions.map(c => ({\n      date: c.transaction_date,\n      title: c.title,\n      order_amount: c.order_amount,\n      commission: c.commission_amount,\n      earned: c.amountEarned,\n      status: c.statusDisplay,\n      is_paid: c.isPaid\n    })),\n    \n    referral_bonuses: shopperReferralBonuses.map(c => ({\n      date: c.transaction_date,\n      earned: c.amountEarned,\n      status: c.statusDisplay,\n      is_paid: c.isPaid\n    })),\n    \n    // Payment history\n    payments: paymentsData.slice(0, 20).map(p => ({\n      id: p.id,\n      amount: p.amount,\n      user_amount: p.user_amount,\n      source: p.source,\n      sent_at: p.sentAt || p.createdAt\n    })),\n    \n    // Brand-specific rates\n    brand_rates: brandRates.map(r => ({\n      brand: r.brand?.name || 'Unknown',\n      rate: r.rate,\n      rate_returning: r.rate_returning\n    })),\n    \n    // Pending vs paid summary\n    pending_count: pendingCommissions.length,\n    paid_count: paidCommissions.length,\n    \n    // Raw referral totals from API\n    referral_totals: payoutSummary.referralTotals || []\n  }\n}];"
      },
