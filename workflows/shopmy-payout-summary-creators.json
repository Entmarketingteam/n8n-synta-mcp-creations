            "creator_id": "={{ $json.creator_id }}",
            "source_platform": "={{ $json.source_platform }}",
            "period_start": "={{ $json.period_start }}",
            "period_end": "={{ $json.period_end }}",
            "normalized_earnings": "={{ $json.normalized_earnings }}",
            "currency": "={{ $json.currency }}",
            "raw_type": "={{ $json.raw_type }}",
            "recorded_at": "={{ $json.recorded_at }}"
          }
        },
        "options": {}
      },
      "id": "append_earnings_sheet",
