    {
      "parameters": {
        "jsCode": "// Map payout summary commissions to canonical schema (CREATOR-EARNINGS-CANONICAL-SCHEMA.md §6).\nconst item = $input.first().json;\nconst creator_id = item.creator_name || item.user_id || 'unknown';\nconst recorded_at = item.extracted_at || new Date().toISOString();\nconst out = [];\nfunction toDate(v) {\n  if (!v) return null;\n  const s = String(v).trim().slice(0, 10);\n  if (/^\\d{4}-\\d{2}-\\d{2}$/.test(s)) return s;\n  const m = String(v).match(/(\\d{4})-(\\d{2})-(\\d{2})/);\n  return m ? m[0] : null;\n}\nfunction pushRow(periodStart, periodEnd, normalized_earnings, raw_type, raw_payload) {\n  if (normalized_earnings == null || isNaN(Number(normalized_earnings))) return;\n  out.push({\n    json: {\n      creator_id,\n      source_platform: 'shopmy',\n      period_start: periodStart || recorded_at.slice(0, 10),\n      period_end: periodEnd || periodStart || recorded_at.slice(0, 10),\n      normalized_earnings: Number(normalized_earnings),\n      currency: 'USD',\n      raw_type,\n      raw_payload: raw_payload || {},\n      recorded_at\n    }\n  });\n}\n(item.normal_commissions || []).forEach(c => {\n  const d = toDate(c.date);\n  pushRow(d, d, c.earned ?? c.commission, 'commission', c);\n});\n(item.opportunity_commissions || []).forEach(c => {\n  const d = toDate(c.date);\n  pushRow(d, d, c.earned ?? c.commission, 'opportunity_commission', c);\n});\n(item.referral_bonuses || []).forEach(c => {\n  const d = toDate(c.date);\n  pushRow(d, d, c.earned, 'referral_bonus', c);\n});\nreturn out.length ? out : [];"
      },
      "id": "normalize_payout_canonical",
      "name": "Normalize Payout to canonical",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1980, 380],
      "notes": "Flattens normal_commissions, opportunity_commissions, referral_bonuses to canonical rows. Append output to same Earnings sheet as Amazon/ShopMy CSV."
    },
