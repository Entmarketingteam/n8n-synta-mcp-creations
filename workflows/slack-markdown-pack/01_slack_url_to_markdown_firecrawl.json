    {"id":"evt_parse","name":"Parse Slack Event (URL)","type":"n8n-nodes-base.code","typeVersion":2,"position":[-140,280],"parameters":{"jsCode":"const body = $json.body || {};\nif (body.type !== 'event_callback') return [];\nconst ev = body.event || {};\nif (ev.bot_id || ev.subtype) return [];\nif (ev.type !== 'message') return [];\nconst text = (ev.text || '').trim();\nconst match = text.match(/https?:\\/\\/[^\\s<>()]+/i);\nif (!match) return [];\nconst url = match[0].replace(/[).,!?]+$/, '');\nreturn [{ json: { channel: ev.channel, ts: ev.ts, thread_ts: ev.ts, url, text } }];"}},
    {"id":"firecrawl_scrape","name":"Firecrawl Scrape","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[120,280],"parameters":{"method":"POST","url":"https://api.firecrawl.dev/v1/scrape","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"=Bearer {{ $env.FIRECRAWL_API_KEY || $vars.FIRECRAWL_API_KEY }}"},{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{ { url: $json.url, formats: [\"markdown\"] } }}","options":{"response":{"response":{"fullResponse":true,"neverError":true}}}}},
    {"id":"parse_firecrawl","name":"Parse Firecrawl Response","type":"n8n-nodes-base.code","typeVersion":2,"position":[380,280],"parameters":{"jsCode":"const prev = $('Parse Slack Event (URL)').first().json;\nconst channel = prev.channel;\nconst thread_ts = prev.thread_ts;\nconst url = prev.url;\nconst res = $input.first().json;\nconst body = (res.body !== undefined ? res.body : res);\nif (res.statusCode && res.statusCode >= 400) {\n  return [{ json: { status: 'error', message: (body && body.message) || `HTTP ${res.statusCode}`, channel, thread_ts, url } }];\n}\nconst md = (body && body.data && body.data.markdown) || (body && body.markdown) || '';\nconst meta = (body && body.data && body.data.metadata) || (body && body.metadata) || {};\nconst title = meta.title || meta.ogTitle || 'Page';\nif (!md || String(md).trim().length < 50) {\n  return [{ json: { status: 'auth_required', message: 'Page may be gated or returned little content', channel, thread_ts, url } }];\n}\nconst mdStr = String(md);\nconst markdown = `## ${title}\\n\\nSource: ${url}\\n\\n---\\n\\n${mdStr.length > 12000 ? mdStr.slice(0,11997) + '...' : mdStr}`;\nreturn [{ json: { status: 'ok', markdown, channel, thread_ts, url } }];"}},
    {"id":"switch_status","name":"Scrape Status?","type":"n8n-nodes-base.switch","typeVersion":3,"position":[620,280],"parameters":{"propertyName":"={{$json.status}}","rules":{"values":[{"outputKey":"ok","renameOutput":true,"conditions":{"combinator":"and","conditions":[{"operator":{"type":"string","operation":"equals"},"leftValue":"={{$json.status}}","rightValue":"ok"}]}},{"outputKey":"auth_required","renameOutput":true,"conditions":{"combinator":"and","conditions":[{"operator":{"type":"string","operation":"equals"},"leftValue":"={{$json.status}}","rightValue":"auth_required"}]}},{"outputKey":"error","renameOutput":true,"conditions":{"combinator":"and","conditions":[{"operator":{"type":"string","operation":"equals"},"leftValue":"={{$json.status}}","rightValue":"error"}]}}]}}},
    {"id":"build_ok","name":"Build OK Thread Reply","type":"n8n-nodes-base.code","typeVersion":2,"position":[860,120],"parameters":{"jsCode":"return [{ json: { channel: $json.channel, thread_ts: $json.thread_ts, text: $json.markdown } }];"}},
    {"id":"build_auth_msg","name":"Build Gated Message","type":"n8n-nodes-base.code","typeVersion":2,"position":[860,280],"parameters":{"jsCode":"return [{ json: { channel: $json.channel, thread_ts: $json.thread_ts, text: `🔒 ${$json.message || 'Page may be gated or inaccessible.'}\\n\\n<${$json.url}|${$json.url}>` } }];"}},
    {"id":"build_error","name":"Build Error Reply","type":"n8n-nodes-base.code","typeVersion":2,"position":[860,420],"parameters":{"jsCode":"return [{ json: { channel: $json.channel, thread_ts: $json.thread_ts, text: `⚠️ Scrape failed.\\n\\n${$json.message || 'Unknown error'}\\n\\n<${$json.url}|${$json.url}>` } }];"}},
    {"id":"slack_post","name":"Slack: Post Thread Reply","type":"n8n-nodes-base.httpRequest","typeVersion":4,"position":[1100,280],"parameters":{"url":"https://slack.com/api/chat.postMessage","method":"POST","sendBody":true,"specifyBody":"json","jsonBody":"={{ { channel: $json.channel, thread_ts: $json.thread_ts, text: $json.text, unfurl_links: false, unfurl_media: false } }}","authentication":"predefinedCredentialType","nodeCredentialType":"slackApi"},"credentials":{"slackApi":{"id":"9Iftrib3bKWQrgqm","name":"Slack MarkItDown (Bot Token)"}}}
