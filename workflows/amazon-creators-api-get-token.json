{
  "name": "Amazon Creators API – Get Token",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger-amazon-creators",
      "name": "Manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 240]
    },
    {
      "parameters": {
        "resource": "secret",
        "operation": "list",
        "project": "ent-agency-automation",
        "config": "prd"
      },
      "id": "doppler-creators-api",
      "name": "Doppler Secrets",
      "type": "n8n-nodes-doppler-secrets.doppler",
      "typeVersion": 1,
      "position": [220, 240],
      "notes": "Fetches AMAZON_CREATORS_API_CLIENT_ID and AMAZON_CREATORS_API_CLIENT_SECRET from Doppler. Assign Doppler credential in n8n."
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "cred-id", "name": "Credential_ID", "value": "={{ $json.AMAZON_CREATORS_API_CLIENT_ID && ($json.AMAZON_CREATORS_API_CLIENT_ID.raw || $json.AMAZON_CREATORS_API_CLIENT_ID) || '' }}", "type": "string" },
            { "id": "cred-secret", "name": "Credential_Secret", "value": "={{ $json.AMAZON_CREATORS_API_CLIENT_SECRET && ($json.AMAZON_CREATORS_API_CLIENT_SECRET.raw || $json.AMAZON_CREATORS_API_CLIENT_SECRET) || '' }}", "type": "string" },
            { "id": "version", "name": "Version", "value": "2.1", "type": "string" }
          ]
        }
      },
      "id": "set-creds-doppler",
      "name": "Set credentials from Doppler",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [440, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://creatorsapi.auth.us-east-1.amazoncognito.com/oauth2/token",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/x-www-form-urlencoded" }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "grant_type", "value": "client_credentials" },
            { "name": "client_id", "value": "={{ $json.Credential_ID ?? $json.Client_ID ?? $vars.AMAZON_CREATORS_API_CLIENT_ID ?? $env.AMAZON_CREATORS_API_CLIENT_ID ?? '' }}" },
            { "name": "client_secret", "value": "={{ $json.Credential_Secret ?? $json.Secret ?? $vars.AMAZON_CREATORS_API_CLIENT_SECRET ?? $env.AMAZON_CREATORS_API_CLIENT_SECRET ?? '' }}" },
            { "name": "scope", "value": "creatorsapi/default" }
          ]
        },
        "options": {}
      },
      "id": "http-get-token-amazon-creators",
      "name": "Get Creators API Token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 240],
      "notes": "Uses Credential_ID and Credential_Secret from Doppler (or $vars if sync script used). Token URL is NA (2.1); for EU/FE change URL per docs."
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "out-token", "name": "access_token", "value": "={{ $json.access_token }}", "type": "string" },
            { "id": "out-expires", "name": "expires_in", "value": "={{ $json.expires_in }}", "type": "number" },
            { "id": "out-version", "name": "credential_version", "value": "={{ $node['Set credentials from Doppler'].json.Version || '2.1' }}", "type": "string" }
          ]
        }
      },
      "id": "set-output-amazon-creators",
      "name": "Output Token",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [880, 240],
      "notes": "Use access_token in Authorization: Bearer <token>, Version <credential_version> for catalog API calls."
    }
  ],
  "connections": {
    "Manual": { "main": [[{ "node": "Doppler Secrets", "type": "main", "index": 0 }]] },
    "Doppler Secrets": { "main": [[{ "node": "Set credentials from Doppler", "type": "main", "index": 0 }]] },
    "Set credentials from Doppler": { "main": [[{ "node": "Get Creators API Token", "type": "main", "index": 0 }]] },
    "Get Creators API Token": { "main": [[{ "node": "Output Token", "type": "main", "index": 0 }]] }
  },
  "pinData": {},
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "tags": [],
  "triggerCount": 0,
  "updatedAt": "2026-02-02T00:00:00.000Z",
  "versionId": "1"
}
