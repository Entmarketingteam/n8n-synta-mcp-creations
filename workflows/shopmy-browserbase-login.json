{
  "name": "ShopMy – Browserbase login → CSV → Webhook",
  "nodes": [
    {
      "id": "manual_trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "parameters": {}
    },
    {
      "id": "schedule_trigger",
      "name": "Schedule (optional)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 220],
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 9 * * 1" }] } }
    },
    {
      "id": "get_creators",
      "name": "Get creators to process",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [240, 110],
      "parameters": {
        "operation": "read",
        "base": { "__rl": true, "mode": "id", "value": "" },
        "table": { "__rl": true, "mode": "id", "value": "" },
        "returnAll": true,
        "filterByFormula": "AND({Needs CSV Sync}=1)"
      }
    },
    {
      "id": "set_creators_fallback",
      "name": "Set creators (fallback / test)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [240, 320],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            { "id": "creatorId", "name": "creatorId", "value": "creator-1", "type": "string" },
            { "id": "creatorEmail", "name": "creatorEmail", "value": "creator@example.com", "type": "string" },
            { "id": "shopmyEmail", "name": "shopmyEmail", "value": "YOUR_SHOPMY_LOGIN_EMAIL", "type": "string" },
            { "id": "shopmyPassword", "name": "shopmyPassword", "value": "YOUR_SHOPMY_PASSWORD", "type": "string" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "loop_creators",
      "name": "Loop over creators",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [460, 110],
      "parameters": { "batchSize": 1 }
    },
    {
      "id": "has_cookies",
      "name": "Has cookies?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [580, 110],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "cookies",
              "leftValue": "={{ $json.ShopMyCookies ?? $json.shopmyCookies ?? $json.shopmy_cookies ?? '' }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        }
      },
      "notes": "If Airtable has ShopMyCookies (stored from POST /auth/refresh), use them to skip login. Else take false branch to refresh."
    },
    {
      "id": "use_stored_cookies",
      "name": "Use stored cookies",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 0],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst raw = item.ShopMyCookies ?? item.shopmyCookies ?? item.shopmy_cookies ?? [];\nconst cookies = typeof raw === 'string' ? (() => { try { return JSON.parse(raw); } catch { return []; } })() : (Array.isArray(raw) ? raw : []);\nreturn [{ json: {\n  creatorId: item.creatorId ?? item.CreatorId ?? 'unknown',\n  creatorEmail: item.creatorEmail ?? item.CreatorEmail ?? '',\n  cookies\n} }];"
      }
    },
    {
      "id": "refresh_cookies",
      "name": "POST /auth/refresh",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 220],
      "parameters": {
        "method": "POST",
        "url": "=YOUR_RUNNER_URL/auth/refresh",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ shopmyEmail: $json.shopmyEmail ?? $json.ShopMyEmail, shopmyPassword: $json.shopmyPassword ?? $json.ShopMyPassword }) }}",
        "options": {}
      },
      "notes": "Runner logs in and returns { cookies }. Store them in Airtable so next run uses POST /run with cookies (no login popup)."
    },
    {
      "id": "prepare_run_body",
      "name": "Prepare run body after refresh",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [820, 220],
      "parameters": {
        "jsCode": "const loopItem = $('Loop over creators').item.json;\nconst refresh = $input.first().json;\nconst cookies = refresh.cookies && Array.isArray(refresh.cookies) ? refresh.cookies : [];\nreturn [{ json: {\n  creatorId: loopItem.creatorId ?? loopItem.CreatorId ?? 'unknown',\n  creatorEmail: loopItem.creatorEmail ?? loopItem.CreatorEmail ?? '',\n  cookies,\n  _recordId: loopItem.id ?? null\n} }];"
      }
    },
    {
      "id": "has_record_id",
      "name": "Has Airtable record id?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [940, 220],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            { "id": "rid", "leftValue": "={{ $json._recordId }}", "rightValue": "", "operator": { "type": "string", "operation": "notEmpty" } }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "update_airtable_cookies",
      "name": "Update Airtable with cookies",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [1160, 120],
      "parameters": {
        "operation": "update",
        "base": { "__rl": true, "mode": "id", "value": "" },
        "table": { "__rl": true, "mode": "id", "value": "" },
        "id": "={{ $json._recordId }}",
        "fields": {
          "ShopMyCookies": "={{ JSON.stringify($json.cookies || []) }}"
        },
        "options": {}
      },
      "notes": "Only when creator came from Airtable (has id). Add column ShopMyCookies (Long text) to your creators table."
    },
    {
      "id": "set_cookies_for_run",
      "name": "Set cookies for run",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1160, 320],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "c1", "name": "creatorId", "value": "={{ $json.creatorId }}", "type": "string" },
            { "id": "c2", "name": "creatorEmail", "value": "={{ $json.creatorEmail }}", "type": "string" },
            { "id": "c3", "name": "cookies", "value": "={{ $json.cookies }}", "type": "array" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "call_runner",
      "name": "Call Browserbase runner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 110],
      "parameters": {
        "method": "POST",
        "url": "=YOUR_RUNNER_URL/run",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ creatorId: $json.creatorId, creatorEmail: $json.creatorEmail, cookies: $json.cookies || [] }) }}",
        "options": {}
      },
      "notes": "When cookies are provided (from stored or refresh), runner skips login. Set YOUR_RUNNER_URL in workflow or env (e.g. Railway runner URL)."
    },
    {
      "id": "check_csv",
      "name": "Has CSV?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 110],
      "parameters": {
        "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" }, "conditions": [{ "id": "csv", "leftValue": "={{ $json.csvData }}", "rightValue": "", "operator": { "type": "string", "operation": "notEmpty" } }], "combinator": "and" }
      }
    },
    {
      "id": "post_webhook",
      "name": "POST to ShopMy CSV webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 0],
      "parameters": {
        "method": "POST",
        "url": "https://entagency.app.n8n.cloud/webhook/shopmy-csv-creators",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ creatorId: $json.creatorId, creatorEmail: $json.creatorEmail, csvData: $json.csvData, reportType: 'shopmy_export' }) }}"
      }
    },
    {
      "id": "no_csv_log",
      "name": "No CSV (log / notify)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1120, 220],
      "parameters": {}
    }
  ],
  "connections": {
    "Manual Trigger": { "main": [[{ "node": "Set creators (fallback / test)", "type": "main", "index": 0 }]] },
    "Schedule (optional)": { "main": [[{ "node": "Get creators to process", "type": "main", "index": 0 }]] },
    "Get creators to process": { "main": [[{ "node": "Loop over creators", "type": "main", "index": 0 }]] },
    "Set creators (fallback / test)": { "main": [[{ "node": "Loop over creators", "type": "main", "index": 0 }]] },
    "Loop over creators": { "main": [[{ "node": "Has cookies?", "type": "main", "index": 0 }]] },
    "Has cookies?": {
      "main": [
        [{ "node": "Use stored cookies", "type": "main", "index": 0 }],
        [{ "node": "POST /auth/refresh", "type": "main", "index": 0 }]
      ]
    },
    "Use stored cookies": { "main": [[{ "node": "Call Browserbase runner", "type": "main", "index": 0 }]] },
    "POST /auth/refresh": { "main": [[{ "node": "Prepare run body after refresh", "type": "main", "index": 0 }]] },
    "Prepare run body after refresh": { "main": [[{ "node": "Set cookies for run", "type": "main", "index": 0 }], [{ "node": "Has Airtable record id?", "type": "main", "index": 0 }]] },
    "Has Airtable record id?": { "main": [[{ "node": "Update Airtable with cookies", "type": "main", "index": 0 }], []] },
    "Set cookies for run": { "main": [[{ "node": "Call Browserbase runner", "type": "main", "index": 0 }]] },
    "Call Browserbase runner": { "main": [[{ "node": "Has CSV?", "type": "main", "index": 0 }]] },
    "Has CSV?": {
      "main": [
        [{ "node": "POST to ShopMy CSV webhook", "type": "main", "index": 0 }],
        [{ "node": "No CSV (log / notify)", "type": "main", "index": 0 }]
      ]
    },
    "POST to ShopMy CSV webhook": { "main": [[{ "node": "Loop over creators", "type": "main", "index": 0 }]] },
    "No CSV (log / notify)": { "main": [[{ "node": "Loop over creators", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
