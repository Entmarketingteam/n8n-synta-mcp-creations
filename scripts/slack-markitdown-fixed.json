        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": { "onError": "continueRegularOutput" }
      },
      "webhookId": "1e0452e7-0825-4001-9fd7-64a6ece12324"
    },
    {
      "id": "manual_trigger",
      "name": "Manual Trigger (test)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 300],
      "parameters": {}
    },
    {
      "id": "url_verification_if",
      "name": "Slack URL verification?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [240, 0],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [{
            "id": "url_verify",
            "leftValue": "={{ ($json.body && $json.body.type) || $json.type || '' }}",
            "rightValue": "url_verification",
            "operator": { "type": "string", "operation": "equals" }
          }]
        }
      }
    },
    {
      "id": "respond_challenge",
      "name": "Respond with challenge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [480, -120],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ challenge: ($json.body && $json.body.challenge) || $json.challenge || '' }) }}"
      }
    },
    {
      "id": "respond_ok",
      "name": "Respond OK to Slack",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [480, 60],
      "parameters": { "respondWith": "noData" }
    },
    {
      "id": "parse_event",
      "name": "Parse Slack Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 60],
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nif (body.type !== 'event_callback') return [];\nconst ev = body.event || {};\n\n// Skip bot messages\nif (ev.bot_id || ev.subtype) return [];\n\nconst channel = ev.channel || ev.channel_id || '';\nconst ts = ev.ts || '';\nconst eventType = ev.type || '';\n\n// File shared event\nif (eventType === 'file_shared') {\n  return [{ json: {\n    path: 'file',\n    channel,\n    thread_ts: ts,\n    file_id: ev.file_id || (ev.file && ev.file.id) || '',\n    filename: (ev.file && ev.file.name) || 'document'\n  }}];\n}\n\n// Message event — extract URL\nif (eventType === 'message') {\n  const text = (ev.text || '').trim();\n  // Strip Slack's <url> or <url|label> wrapping, then match\n  const cleaned = text.replace(/<(https?:\\/\\/[^|>]+)[^>]*>/gi, '$1');\n  const match = cleaned.match(/https?:\\/\\/[^\\s<>]+/i);\n  if (!match) return [];\n  const url = match[0].replace(/[).,!?]+$/, '');\n  return [{ json: {\n    path: 'url',\n    channel,\n    thread_ts: ts,\n    url\n  }}];\n}\n\nreturn [];"
      }
    },
    {
      "id": "route_path",
      "name": "File or URL?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [960, 60],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [{
            "id": "is_file",
            "leftValue": "={{ $json.path }}",
            "rightValue": "file",
            "operator": { "type": "string", "operation": "equals" }
          }]
        }
      }
    },
    {
      "id": "slack_get_file",
      "name": "Slack get file info",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.4,
      "position": [1200, -60],
      "parameters": {
        "operation": "get",
        "resource": "file",
        "fileId": "={{ $json.file_id }}",
        "select": "id",
        "target": "file"
      },
      "credentials": {
        "slackOAuth2Api": {
          "id": "PhBEyMsaxJ4k1bi7",
          "name": "Slack (MarkItDown app A0ACJ4HNKDY)"
        }
      }
    },
    {
      "id": "download_slack_file",
      "name": "Download file from Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [1440, -60],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url_private_download }}",
        "options": { "timeout": 30000 },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "nodeCredentialType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "X3uZ5J8wbqoJEu4Q",
          "name": "Slack Bot Token (Bearer)"
        }
      }
    },
    {
      "id": "call_markitdown_file",
      "name": "Call MarkItDown API (file)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [1680, -60],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MARKITDOWN_API_URL || 'https://markitdown-api.railway.app' }}/convert",
        "sendBody": true,
        "specifyBody": "multipart-form-data",
        "bodyParameters": {
          "parameters": [{
            "parameterType": "formBinaryData",
            "name": "file",
            "inputDataFieldName": "data",
            "mimeType": ""
          }]
        },
        "options": { "timeout": 60000 },
        "nodeCredentialType": "none",
        "contentType": "multipart-form-data"
      }
    },
    {
      "id": "call_markitdown_url",
      "name": "Call MarkItDown API (URL)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [1200, 180],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MARKITDOWN_API_URL || 'https://markitdown-api.railway.app' }}/convert",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ url: $json.url }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{
            "name": "Content-Type",
            "value": "application/json"
          }]
        },
        "options": {
          "timeout": 60000,
          "response": { "response": { "fullResponse": true, "neverError": true } }
        },
        "nodeCredentialType": "none"
      }
    },
    {
      "id": "normalize_response",
      "name": "Normalize MarkItDown response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1920, 60],
      "parameters": {
        "jsCode": "// Get the MarkItDown API response\nconst input = $input.first().json;\nconst res = input.body !== undefined ? input.body : input;\n\n// Get channel context from Parse Slack Event (always in the execution path)\nconst ctx = $('Parse Slack Event').first().json;\nconst channel = ctx.channel || '';\nconst thread_ts = ctx.thread_ts || '';\n\n// Extract markdown\nconst markdown = (res && res.markdown) || '';\nconst error = (res && res.error) || '';\nconst ok = markdown.length > 0;\n\nreturn [{ json: { channel_id: channel, thread_ts, ok, markdown, error } }];"
      }
    },
    {
      "id": "if_convert_ok",
      "name": "Conversion OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2160, 60],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [{
            "id": "conv_ok",
            "leftValue": "={{ $json.ok }}",
            "rightValue": true,
            "operator": { "type": "boolean", "operation": "equals" }
          }]
        }
      }
    },
    {
      "id": "openai_chat",
      "name": "OpenAI Chat",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.1,
      "position": [2400, -60],
      "parameters": {
        "resource": "chat",
        "model": "gpt-4o-mini",
        "messages": { "values": [{}, {}] },
        "options": { "maxTokens": 1024 },
        "operation": "complete",
        "prompt": {
          "messages": [{
            "values": [{}, {}],
            "role": "system",
            "content": "Use the document (markdown) provided to answer or summarize. Be concise."
          }]
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "2Bpl4Q8V6xvvCFdh",
          "name": "OpenAI API KEY"
        }
      }
    },
    {
      "id": "normalize_llm_response",
      "name": "Normalize LLM output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2640, -60],
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst ctx = $('Normalize MarkItDown response').first().json;\nconst llm = input.message && input.message.content\n  || (input.choices && input.choices[0] && input.choices[0].message && input.choices[0].message.content)\n  || input.text\n  || JSON.stringify(input);\nreturn [{ json: { channel_id: ctx.channel_id, thread_ts: ctx.thread_ts, llm_response: llm } }];"
      }
    },
    {
      "id": "slack_reply",
      "name": "Slack reply (success)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.4,
      "position": [2880, -60],
      "parameters": {
        "select": "channel",
        "channelId": { "__rl": true, "value": "={{ $json.channel_id }}", "mode": "id" },
        "text": "={{ $json.llm_response }}",
        "otherOptions": { "thread_ts": "={{ $json.thread_ts || undefined }}" },
        "resource": "message",
        "operation": "post",
        "target": "channel"
      },
      "credentials": {
        "slackOAuth2Api": {
          "id": "PhBEyMsaxJ4k1bi7",
          "name": "Slack (MarkItDown app A0ACJ4HNKDY)"
        }
      }
    },
    {
      "id": "slack_reply_error",
      "name": "Slack reply (error)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.4,
      "position": [2400, 180],
      "parameters": {
        "select": "channel",
        "channelId": { "__rl": true, "value": "={{ $json.channel_id }}", "mode": "id" },
        "text": "=Sorry, conversion failed: {{ $json.error || 'Unknown error' }}",
        "otherOptions": { "thread_ts": "={{ $json.thread_ts || undefined }}" },
        "resource": "message",
        "operation": "post",
        "target": "channel"
      },
      "credentials": {
        "slackOAuth2Api": {
          "id": "PhBEyMsaxJ4k1bi7",
          "name": "Slack (MarkItDown app A0ACJ4HNKDY)"
        }
      }
    }
  ],
