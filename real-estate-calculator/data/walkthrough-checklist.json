{
  "rooms": [
    {
      "id": "exterior_front",
      "label": "Exterior - Front",
      "items": [
        "Roof condition (missing shingles, sagging, multiple layers)",
        "Gutters and downspouts (attached, clean, draining away from foundation)",
        "Siding/brick condition (cracks, rot, gaps)",
        "Foundation visible cracks (stair-step pattern = settlement issue)",
        "Front door condition",
        "Porch/deck structural integrity",
        "Driveway condition (cracks, settling)",
        "Landscaping overgrowth (sign of neglect)",
        "Mailbox, address numbers, curb appeal"
      ]
    },
    {
      "id": "exterior_back",
      "label": "Exterior - Back",
      "items": [
        "Deck/patio condition and safety",
        "Grading (does ground slope away from foundation?)",
        "Fence condition and property line alignment",
        "Outbuildings/shed condition",
        "Septic or sewer access points",
        "Drainage issues (standing water, erosion)",
        "Trees too close to house or power lines"
      ]
    },
    {
      "id": "kitchen",
      "label": "Kitchen",
      "items": [
        "Cabinet condition (doors, hinges, soft-close)",
