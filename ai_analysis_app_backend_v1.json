    {
      "parameters": {
        "jsCode": "// Convert base64 image from request body → n8n binary data\n// Frontend should send: { token, image (base64 string), mimeType, filename }\nconst base64Image = $('webhook').item.json.image;\nconst mimeType = $('webhook').item.json.mimeType || 'image/jpeg';\nconst filename = $('webhook').item.json.filename || 'upload.jpg';\n\nif (!base64Image) {\n  throw new Error('Missing \"image\" field. Expected JSON body: { token, image (base64), mimeType, filename }');\n}\n\n// Strip data URL prefix if present (e.g. 'data:image/jpeg;base64,')\nconst cleanBase64 = base64Image.replace(/^data:[^;]+;base64,/, '');\n\nreturn [{\n  json: $json,\n  binary: {\n    image: await this.helpers.prepareBinaryData(\n      Buffer.from(cleanBase64, 'base64'),\n      filename,\n      mimeType\n    )\n  }\n}];"
      },
