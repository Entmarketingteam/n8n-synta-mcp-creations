# Copy to .env and fill in values. Never commit .env.
# Used by amazon_associates_scraper.py (Playwright login + report download).

# Creator: Amazon Associates login (e.g. Nicki Entenmann)
AMAZON_ASSOC_EMAIL=your-creator@example.com
AMAZON_ASSOC_PASSWORD=your-secure-password

# Optional: comma-separated tracking IDs (e.g. nicki-20,sara-20)
# AMAZON_TRACKING_IDS=nicki-20
